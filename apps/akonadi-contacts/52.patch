From d158ebab68a70d02e3908c49794ea9353ed2b851 Mon Sep 17 00:00:00 2001
From: Carl Schwan <carl@carlschwan.eu>
Date: Tue, 11 Mar 2025 18:41:00 +0100
Subject: [PATCH] Port away from AgentInstanceCreateJob::configure

---
 .../job/addemailaddressjob.cpp                | 21 +++++++++++++++---
 .../job/addemaildisplayjob.cpp                | 22 ++++++++++++++++---
 2 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/src/akonadi-contacts-widgets/job/addemailaddressjob.cpp b/src/akonadi-contacts-widgets/job/addemailaddressjob.cpp
index e44bd9c61..f9aec4e8f 100644
--- a/src/akonadi-contacts-widgets/job/addemailaddressjob.cpp
+++ b/src/akonadi-contacts-widgets/job/addemailaddressjob.cpp
@@ -7,8 +7,11 @@
 
 #include "addemailaddressjob.h"
 #include "widgets/selectaddressbookdialog.h"
+#include <Akonadi/AgentConfigurationDialog>
 #include <Akonadi/AgentFilterProxyModel>
+#include <Akonadi/AgentInstance>
 #include <Akonadi/AgentInstanceCreateJob>
+#include <Akonadi/AgentManager>
 #include <Akonadi/AgentType>
 #include <Akonadi/AgentTypeDialog>
 #include <Akonadi/Collection>
@@ -132,10 +135,22 @@ public:
 
                     if (agentType.isValid()) {
                         auto job = new Akonadi::AgentInstanceCreateJob(agentType, q);
-                        q->connect(job, &Akonadi::AgentInstanceCreateJob::result, q, [this](KJob *job) {
-                            slotResourceCreationDone(job);
+                        q->connect(job, &Akonadi::AgentInstanceCreateJob::result, q, [this, job](KJob *) {
+                            if (job->error()) {
+                                slotResourceCreationDone(job);
+                                return;
+                            }
+                            auto configureDialog = new Akonadi::AgentConfigurationDialog(job->instance(), mParentWidget);
+                            configureDialog->setAttribute(Qt::WA_DeleteOnClose);
+                            q->connect(configureDialog, &QDialog::rejected, q, [this, instance = job->instance()] {
+                                Akonadi::AgentManager::self()->removeInstance(instance);
+                                q->emitResult();
+                            });
+                            q->connect(configureDialog, &QDialog::accepted, q, [this] {
+                                createContact();
+                            });
+                            configureDialog->show();
                         });
-                        job->configure(mParentWidget);
                         job->start();
                         delete dlg;
                         return;
diff --git a/src/akonadi-contacts-widgets/job/addemaildisplayjob.cpp b/src/akonadi-contacts-widgets/job/addemaildisplayjob.cpp
index d445c5782..b38e20d9a 100644
--- a/src/akonadi-contacts-widgets/job/addemaildisplayjob.cpp
+++ b/src/akonadi-contacts-widgets/job/addemaildisplayjob.cpp
@@ -6,8 +6,11 @@
 
 #include "addemaildisplayjob.h"
 #include "widgets/selectaddressbookdialog.h"
+#include <Akonadi/AgentConfigurationDialog>
 #include <Akonadi/AgentFilterProxyModel>
+#include <Akonadi/AgentInstance>
 #include <Akonadi/AgentInstanceCreateJob>
+#include <Akonadi/AgentManager>
 #include <Akonadi/AgentType>
 #include <Akonadi/AgentTypeDialog>
 #include <Akonadi/Collection>
@@ -172,10 +175,23 @@ public:
 
                     if (agentType.isValid()) {
                         auto job = new Akonadi::AgentInstanceCreateJob(agentType, q);
-                        q->connect(job, &Akonadi::AgentInstanceCreateJob::result, q, [this](KJob *job) {
-                            slotResourceCreationDone(job);
+                        q->connect(job, &Akonadi::AgentInstanceCreateJob::result, q, [this, job](KJob *) {
+                            if (job->error()) {
+                                slotResourceCreationDone(job);
+                                return;
+                            }
+                            auto configureDialog = new Akonadi::AgentConfigurationDialog(job->instance(), mParentWidget);
+                            configureDialog->setAttribute(Qt::WA_DeleteOnClose);
+                            q->connect(configureDialog, &QDialog::rejected, q, [this, instance = job->instance()] {
+                                Akonadi::AgentManager::self()->removeInstance(instance);
+                                q->emitResult();
+                            });
+                            q->connect(configureDialog, &QDialog::accepted, q, [this] {
+                                createContact();
+                            });
+                            configureDialog->show();
                         });
-                        job->configure(mParentWidget);
+
                         job->start();
                         delete dlg;
                         return;
